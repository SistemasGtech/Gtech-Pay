{
  "appId": "com.gtech.pdv",
  "appName": "Gtech Pay",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "includePlugins": ["@devlas/capacitor-thermal-printer", "@capacitor/splash-screen"]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0f172a",
      "androidScaleType": "CENTER",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
